# TradeShield Configuration
# Copy this file to .env and fill in your personal values:

# Telegram Bot Credentials (Get from @BotFather and @userinfobot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Trading Capital in INR (Default: ₹5,000)
TRADE_CAPITAL=5000.0

# Max Risk per Trade Percentage (Default: 2.0%)
MAX_RISK_PCT=2.0

